MONGO_URI=mongodb://localhost:27017/your_database
REDIS_URL=redis://localhost:6379
REMINDER_REDIS_URL=
NODE_ENV=development
PORT=5000

# Shared with the Python worker. Redis is the schedule layer only.
REMINDER_SCHEDULE_KEY=buddy:reminder:schedule
REMINDER_PROCESSING_KEY=buddy:reminder:processing
REMINDER_RETRY_KEY=buddy:reminder:retry
REMINDER_DEAD_LETTER_KEY=buddy:reminder:dead-letter
REMINDER_LATE_GRACE_SECONDS=300
REMINDER_PAYLOAD_TTL_SECONDS=1209600
