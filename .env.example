MONGO_URI=mongodb://localhost:27017/your_database
# Optional Mongo resilience knobs (useful for remote EC2 / flaky networks)
# MONGO_CONNECT_RETRIES=5
# MONGO_CONNECT_RETRY_MS=1500
# MONGO_MAX_POOL_SIZE=10
# MONGO_SERVER_SELECTION_TIMEOUT_MS=15000
# MONGO_SOCKET_TIMEOUT_MS=45000
REDIS_URL=redis://localhost:6379
REMINDER_REDIS_URL=
NODE_ENV=development
PORT=5000

# Inbox that receives website contact-form submissions.
CONTACT_INBOX=team@kukunotes.com
# Legacy Gmail transporter used by the contact form only.
# MAIL_USER=
# MAIL_PASS=

# Zoho Mail SMTP (paid organization). Official guide:
# https://www.zoho.com/mail/help/zoho-smtp.html
# From address must be this mailbox or one of its aliases.
ZOHO_MAIL_USER=
# Application-specific password when MFA is on. Do not use the account password then.
# https://help.zoho.com/portal/en/kb/accounts/manage-your-zoho-account/articles/mfa-application-specific-passwords
ZOHO_MAIL_APP_PASSWORD=
# Datacenter: com | in | eu | au | jp | ca | sa | ae. Confirm in Zoho Mail server settings.
ZOHO_DC=in
# Optional override of the host derived from ZOHO_DC. Paid org default is smtppro.zoho.<dc>.
# ZOHO_SMTP_HOST=smtppro.zoho.in
# 465 = SSL, 587 = TLS
ZOHO_SMTP_PORT=465
ZOHO_MAIL_FROM_NAME=KukuNotes
# Public app origin used in invitation links. No trailing slash.
APP_PUBLIC_URL=http://127.0.0.1:5173

# Shared with the Python worker. Redis is the schedule layer only.
REMINDER_SCHEDULE_KEY=buddy:reminder:schedule
REMINDER_PROCESSING_KEY=buddy:reminder:processing
REMINDER_RETRY_KEY=buddy:reminder:retry
REMINDER_DEAD_LETTER_KEY=buddy:reminder:dead-letter
REMINDER_LATE_GRACE_SECONDS=300
REMINDER_PAYLOAD_TTL_SECONDS=1209600

# Daily briefing generation lives in AI_Orchestration (Python).
# Node only reads Mongo collection `daily_briefings` via GET /home/getDailyBriefing.
# Temporary test button also needs Python:
# BUDDY_API_BASE=https://your-python-host/api/v1
BUDDY_API_BASE=

# Chrome meeting-extension backend (additive). Existing mobile routes ignore this flag.
# Meeting audio jobs use REDIS_URL + REDIS_STT_STREAM (same as the mobile app).
# Do not point meeting jobs at REMINDER_REDIS_URL.
MEETING_EXTENSION_ENABLED=false
MEETING_CHUNK_MAX_SIZE_MB=20
MEETING_CHUNK_MAX_DURATION_SECONDS=60
MEETING_CHUNK_DURATION_MS=20000
MEETING_UPLOAD_PRESIGN_TTL_SECONDS=900
MEETING_PLAYBACK_PRESIGN_TTL_SECONDS=900
MEETING_RECORDING_STALE_AFTER_MINUTES=180
MEETING_SOURCE_CHUNK_RETENTION_DAYS=7
MEETING_VIDEO_FINALIZATION_ENABLED=true
MEETING_S3_PREFIX=meetings
MEETING_CREATE_RATE_LIMIT_PER_MINUTE=10
MEETING_PRESIGN_RATE_LIMIT_PER_MINUTE=60
REDIS_STT_STREAM=buddy:stt:jobs
REDIS_MEETING_MERGE_STREAM=buddy:meeting:video-merge
REDIS_FINALIZATION_STREAM=buddy:conversation:finalization
QUEUE_API_BASE_URL=
QUEUE_API_SERVICE_TOKEN=
QUEUE_API_HMAC_SECRET=
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Calendar integration (Web OAuth client; enable "Google Calendar API" in the same project)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI on the OAuth client.
# e.g. http://127.0.0.1:5000/api/v1/integrations/google-calendar/callback
GOOGLE_CALENDAR_REDIRECT_URI=
# Optional; defaults to AUTH_TOKEN_SECRET / SESSION_SECRET. Changing it invalidates stored Google tokens.
TOKEN_ENCRYPTION_KEY=
